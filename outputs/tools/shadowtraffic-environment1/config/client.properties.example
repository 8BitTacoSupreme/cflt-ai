# Copy this file to client.properties (gitignored) and fill in real values.
# Never commit the filled-in version - it holds live Confluent Cloud credentials.
#
# bootstrap.servers / schema.registry.url came from the environment's terraform
# outputs (kafka_bootstrap_endpoints["enterprise"], and the Schema Registry
# cluster lsrc-xxxxx's REST endpoint - look it up with:
#   confluent schema-registry cluster describe --environment env-xxxxx
# or in the Confluent Cloud UI under Environment > <your-environment> > Schema Registry.
#
# API key/secret pairs come from AWS Secrets Manager on the bastion:
#   confluent/<env>/datagen-enterprise-kafka-creds   (Kafka key/secret)
# and the admin-scoped Schema Registry key created alongside it
# (module.iam.confluent_api_key.sr_keys["admin:schema_registry"] in terraform
# state) - confirm which secret holds the SR key/secret pair before filling
# basic.auth.user.info below; it may be bundled into admin-enterprise-kafka-creds
# or need to be pulled from terraform output/state directly.

bootstrap.servers=<cluster-id>.<region>.aws.private.confluent.cloud:9092
security.protocol=SASL_SSL
sasl.mechanism=PLAIN
sasl.jaas.config=org.apache.kafka.common.security.plain.PlainLoginModule required username='<DATAGEN_KAFKA_API_KEY>' password='<DATAGEN_KAFKA_API_SECRET>';

schema.registry.url=https://<SCHEMA_REGISTRY_REST_ENDPOINT>
basic.auth.credentials.source=USER_INFO
basic.auth.user.info=<SR_API_KEY>:<SR_API_SECRET>
